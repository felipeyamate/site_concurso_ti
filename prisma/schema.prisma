// =============================================================================
// schema.prisma — Estrutura do banco de dados (tabelas, colunas e relações).
//
// Quem usa: o CLI do Prisma. A partir deste arquivo ele:
//   1. gera as migrações SQL (`npm run db:migrate`), que criam/alteram as tabelas;
//   2. gera o cliente TypeScript tipado em `src/generated/prisma` (`npm run db:generate`).
//
// Paralelo em Python: é como os `models.py` do SQLAlchemy/Django num único arquivo.
//
// Convenções:
// - No código, os nomes ficam em camelCase (padrão do TypeScript): `emailVerified`.
// - No banco, tabelas e colunas ficam em snake_case (`email_verified`) via @map/@@map,
//   para facilitar consultas SQL diretas (ex.: no console da Neon ou em ferramentas de BI).
//
// Fase 1: tabelas de contas/autenticação.
// Fase 2: catálogo (Course, Module, Lesson), matrículas (Enrollment) e progresso (LessonProgress).
// Fase 3: materiais das aulas em PDF (LessonAttachment) e o link do player do Panda na aula.
// Fase 4: vendas — produtos (Product), planos de assinatura (Plan), pedidos (Order), assinaturas
// (Subscription), cobranças (Payment), avisos do provedor (WebhookEvent) e notas fiscais (FiscalInvoice).
// Fase 5: banco de questões — bancas (Board), assuntos (Subject), provas de concurso (Exam), questões
// (Question + QuestionOption), respostas dos alunos (QuestionAttempt) e simulados (MockExam).
// Fase 6: marketing — cupons (Coupon), afiliados (Affiliate + cliques e pagamentos de comissão),
// posts do blog (BlogPost), páginas de edital (ExamNotice) e endereços antigos (SlugRedirect).
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // A URL de conexão fica em `prisma.config.ts` (lida das variáveis de ambiente).
}

// Perfis de usuário. A ordem de poder é: STUDENT < TEACHER < ADMIN
// (a regra de "quem pode o quê" fica em `src/modules/auth/roles.ts`).
enum Role {
  STUDENT
  TEACHER
  ADMIN
}

// -----------------------------------------------------------------------------
// Tabelas usadas pelo Better Auth (biblioteca de autenticação).
// Os nomes dos campos seguem o que o Better Auth espera — não renomeie no código
// sem ajustar a configuração em `src/modules/auth/auth.ts`.
// -----------------------------------------------------------------------------

// Uma pessoa cadastrada (aluno, professor ou administrador).
model User {
  id               String            @id
  name             String
  email            String            @unique
  emailVerified    Boolean           @default(false) @map("email_verified")
  image            String?
  // Perfil do usuário. Todo cadastro novo nasce como STUDENT; só um script/admin promove.
  role             Role              @default(STUDENT)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  sessions         Session[]
  accounts         Account[]
  enrollments      Enrollment[]
  progress         LessonProgress[]
  // Fase 4 (vendas). Pedidos e assinaturas NÃO são apagados junto com o usuário (histórico
  // financeiro/fiscal): apagar uma conta com compras é tratado na Fase 7 (LGPD).
  billingProfile   BillingProfile?
  orders           Order[]
  subscriptions    Subscription[]
  // Fase 5 (banco de questões): respostas e simulados do aluno.
  questionAttempts QuestionAttempt[]
  mockExams        MockExam[]
  // Fase 6 (marketing): cadastro de afiliado, pagamentos de comissão registrados (admin) e posts.
  affiliate        Affiliate?
  affiliatePayouts AffiliatePayout[] @relation("AffiliatePayoutCreatedBy")
  blogPosts        BlogPost[]
  // Fase 7 (LGPD): versão dos Termos/Política de privacidade que a pessoa aceitou por último
  // (null = ainda não aceitou a versão atual → a área logada pede o aceite antes de continuar),
  // o histórico dos aceites e quando a conta foi EXCLUÍDA a pedido (a linha fica, anonimizada,
  // porque pedidos e pagamentos precisam ser guardados pela lei fiscal).
  legalVersion     String?           @map("legal_version")
  legalConsents    LegalConsent[]
  accessLogs       AccessLog[]
  deletedAt        DateTime?         @map("deleted_at")

  @@map("users")
}

// ============================================================================================
// Fase 7 — LGPD
// ============================================================================================

// Como o aceite aconteceu: no cadastro (caixa marcada no formulário) ou na tela de aceite
// (quem entrou pelo Google/link mágico, ou quando os textos mudaram de versão).
enum ConsentSource {
  SIGN_UP
  REVIEW
}

// Registro de consentimento (LGPD, art. 8º: cabe a nós provar que a pessoa concordou).
// Cada aceite vira uma linha — nunca é apagada nem alterada (nem na exclusão da conta).
model LegalConsent {
  id         String        @id @default(cuid())
  userId     String        @map("user_id")
  user       User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  // Versão dos Termos de uso + Política de privacidade aceitos juntos (ex.: "2026-10-01").
  version    String
  source     ConsentSource
  // De onde veio o aceite (prova). IP e navegador informados pela requisição.
  ipAddress  String?       @map("ip_address")
  userAgent  String?       @map("user_agent")
  acceptedAt DateTime      @default(now()) @map("accepted_at")

  @@index([userId, acceptedAt])
  @@map("legal_consents")
}

// Registro de acesso exigido pelo Marco Civil da Internet (Lei 12.965/2014, art. 15): data, hora e
// IP de cada login, guardados por 6 meses (a limpeza diária apaga os mais velhos). Fica mesmo se a
// conta for excluída (a conta é anonimizada, não apagada). `Cascade` só importa nos testes, que
// apagam usuários de verdade; no site, usuário nunca é apagado.
model AccessLog {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("access_logs")
}

// Um login ativo em um dispositivo/navegador. O navegador guarda só o `token` (num cookie).
// Apagar a linha = deslogar aquele dispositivo. Usamos isso para o limite de sessões.
model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("sessions")
}

// Forma de login ligada ao usuário: "credential" (e-mail/senha, com o hash da senha)
// ou um provedor externo como "google" (com os tokens OAuth).
model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  // Hash da senha (algoritmo scrypt). A senha em texto puro nunca é gravada.
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("accounts")
}

// Códigos temporários: verificação de e-mail, redefinição de senha, link mágico.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

// Contador de tentativas por IP/rota (proteção contra força bruta no login).
// Fica no banco porque, na Vercel, cada requisição pode cair num servidor diferente.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("rate_limits")
}

// -----------------------------------------------------------------------------
// Catálogo (Fase 2): Curso → Módulos → Aulas.
// O conteúdo é cadastrado no painel (/admin/cursos, Fase 3). O seed (`npm run db:seed`) cria
// um curso de exemplo, só para desenvolvimento.
// -----------------------------------------------------------------------------

// Um curso (ex.: "Informática e TI para Concursos — do zero").
model Course {
  id                     String          @id @default(cuid())
  // Identificador usado na URL: /cursos/<slug>. Só letras minúsculas, números e hífens.
  slug                   String          @unique
  title                  String
  // Frase curta que aparece no catálogo, embaixo do título.
  subtitle               String?
  description            String
  // Só cursos publicados aparecem para os alunos. Rascunhos: só TEACHER/ADMIN veem.
  isPublished            Boolean         @default(false) @map("is_published")
  // Ordem no catálogo (menor primeiro).
  position               Int             @default(0)
  // Fase 4: o curso faz parte da assinatura? Quem tem assinatura paga assiste a TODOS os cursos
  // marcados aqui (PROJECT.md, seção 6: "Plan → libera todos os cursos inclusos na assinatura").
  includedInSubscription Boolean         @default(false) @map("included_in_subscription")
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")
  modules                Module[]
  lessons                Lesson[]
  enrollments            Enrollment[]
  products               ProductCourse[]
  orderItems             OrderCourse[]

  @@map("courses")
}

// Um módulo agrupa aulas de um mesmo assunto dentro do curso (ex.: "Segurança da Informação").
model Module {
  id        String   @id @default(cuid())
  courseId  String   @map("course_id")
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  position  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  lessons   Lesson[]

  @@unique([courseId, position])
  // Permite que a aula aponte para (módulo, curso) juntos — ver o comentário em Lesson.
  @@unique([id, courseId])
  @@map("modules")
}

// De onde vem o vídeo de uma aula. A escolha do fornecedor fica em `src/modules/video`.
enum VideoProvider {
  // Vídeo de exemplo, só para desenvolvimento (bloqueado no site de produção).
  DEV
  // Panda Video (Fase 3): player do Panda num <iframe>, com a marca d'água (DRM) do aluno.
  PANDA
}

// Uma aula. Guarda `courseId` além do `moduleId` para garantir que o `slug` (usado na URL)
// seja único dentro do curso inteiro: /cursos/<curso>/aulas/<aula>.
// A ligação com o módulo usa (moduleId, courseId) juntos: assim o BANCO recusa uma aula cujo
// curso seja diferente do curso do seu módulo (a checagem de acesso usa o `courseId` da aula).
model Lesson {
  id              String             @id @default(cuid())
  courseId        String             @map("course_id")
  course          Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  moduleId        String             @map("module_id")
  module          Module             @relation(fields: [moduleId, courseId], references: [id, courseId], onDelete: Cascade)
  slug            String
  title           String
  // Resumo em linguagem simples, mostrado embaixo do vídeo.
  description     String             @default("")
  // Ordem dentro do módulo (menor primeiro).
  position        Int
  // Duração aproximada, para mostrar no catálogo (o player informa a duração real).
  durationSeconds Int                @default(0) @map("duration_seconds")
  // Aula grátis: qualquer pessoa LOGADA assiste, mesmo sem matrícula (ajuda a vender o curso).
  isFreePreview   Boolean            @default(false) @map("is_free_preview")
  isPublished     Boolean            @default(true) @map("is_published")
  videoProvider   VideoProvider      @default(DEV) @map("video_provider")
  // Identificador do vídeo no fornecedor (ex.: o ID do vídeo no Panda). Vazio = aula sem vídeo.
  videoId         String?            @map("video_id")
  // Panda: endereço do player ("embed") do vídeo, ex.: https://player-vz-xxxx.tv.pandavideo.com.br/embed/?v=<id>.
  // Cada conta do Panda tem o seu endereço de player; por isso guardamos o link inteiro, já conferido
  // (só aceitamos endereços do Panda — ver `src/modules/video/panda/embed.ts`).
  videoEmbedUrl   String?            @map("video_embed_url")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  progress        LessonProgress[]
  attachments     LessonAttachment[]

  @@unique([courseId, slug])
  @@unique([moduleId, position])
  @@map("lessons")
}

// Material de apoio de uma aula (PDF: resumo, slides, lista de exercícios). Fase 3.
// O arquivo em si fica no armazenamento de arquivos (Cloudflare R2; em desenvolvimento, uma pasta
// local). Aqui fica só o "endereço" dele (`storageKey`) e os dados para mostrar na tela.
// O aluno nunca recebe o endereço fixo do arquivo: a cada clique geramos um link temporário,
// DEPOIS de conferir o acesso à aula (mesma regra do vídeo).
model LessonAttachment {
  id         String   @id @default(cuid())
  lessonId   String   @map("lesson_id")
  lesson     Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  // Nome mostrado para o aluno (ex.: "Resumo — Segurança da Informação").
  title      String
  // Nome original do arquivo enviado (usado no download: "resumo.pdf").
  fileName   String   @map("file_name")
  // Caminho do arquivo no armazenamento, ex.: lessons/<id-da-aula>/<uuid>.pdf
  storageKey String   @unique @map("storage_key")
  sizeBytes  Int      @map("size_bytes")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([lessonId])
  @@map("lesson_attachments")
}

// -----------------------------------------------------------------------------
// Matrículas (Fase 2): quem pode ver qual curso e até quando.
// REGRA QUE NÃO MUDA: quem decide se o aluno vê uma aula é SÓ a matrícula (PROJECT.md, seção 6).
//
// Fase 4: uma matrícula por aluno, curso e ORIGEM. Cada origem cuida da sua linha:
//  - MANUAL: criada/renovada/revogada à mão (painel e `npm run enroll`, via `grant.ts`);
//  - PURCHASE e SUBSCRIPTION: RECALCULADAS a partir dos pagamentos confirmados (webhook do
//    provedor), em `src/modules/payments/access-sync.server.ts`. Um reembolso refaz a conta sem
//    aquele pagamento — nunca "apaga" o que veio de outra origem.
// O acesso vale se QUALQUER linha do aluno naquele curso estiver ativa (`mergeEnrollments`).
// -----------------------------------------------------------------------------

enum EnrollmentSource {
  // Criada à mão (script/admin): cortesia, testes, alunos antigos.
  MANUAL
  // Compra avulsa confirmada (Fase 4).
  PURCHASE
  // Assinatura paga (Fase 4).
  SUBSCRIPTION
}

model Enrollment {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String           @map("course_id")
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  source    EnrollmentSource @default(MANUAL)
  startsAt  DateTime         @default(now()) @map("starts_at")
  // Vazio = sem data de fim. Curso avulso: ex. 12 meses depois da compra.
  expiresAt DateTime?        @map("expires_at")
  // Preenchido quando o acesso é cancelado (ex.: reembolso). Não apagamos a linha: fica o histórico.
  revokedAt DateTime?        @map("revoked_at")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  // Uma matrícula por aluno, curso e origem: renovar = estender a mesma linha.
  @@unique([userId, courseId, source])
  @@index([courseId])
  @@map("enrollments")
}

// -----------------------------------------------------------------------------
// Progresso (Fase 2): onde o aluno parou em cada aula e o que já concluiu.
// -----------------------------------------------------------------------------

model LessonProgress {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId        String    @map("lesson_id")
  lesson          Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  // Segundo do vídeo em que o aluno parou (para "continuar de onde parou").
  positionSeconds Int       @default(0) @map("position_seconds")
  // Duração real informada pelo player.
  durationSeconds Int?      @map("duration_seconds")
  // Preenchido quando a aula é concluída (assistiu até perto do fim ou marcou à mão).
  completedAt     DateTime? @map("completed_at")
  lastWatchedAt   DateTime  @default(now()) @map("last_watched_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([userId, lessonId])
  @@index([userId, lastWatchedAt])
  @@map("lesson_progress")
}

// -----------------------------------------------------------------------------
// Vendas (Fase 4): o que se vende, quem comprou e o que o provedor de pagamento avisou.
//
// REGRAS QUE NÃO MUDAM (PROJECT.md, seção 6):
//  - Pagamento nunca libera acesso direto: pagamento confirmado → recalcula a matrícula.
//  - Acesso só é liberado pelo AVISO do provedor (webhook), nunca pela página de "sucesso".
//  - Avisos repetidos não duplicam nada (WebhookEvent com o ID do evento como chave única).
//  - Reembolso/estorno revoga o acesso daquela compra automaticamente.
// Valores em dinheiro ficam em CENTAVOS (Int): R$ 97,90 = 9790. Assim não há erro de
// arredondamento (como usar `Decimal` em vez de `float` no Python).
// -----------------------------------------------------------------------------

// Quem cobra. ASAAS = de verdade; FAKE = simulado (só desenvolvimento, sem conta no Asaas).
enum PaymentProviderKind {
  ASAAS
  FAKE
}

// Forma de pagamento escolhida pelo aluno.
enum PaymentMethod {
  PIX
  BOLETO
  CREDIT_CARD
}

// Produto à venda: um curso avulso ou um pacote de cursos, com acesso por N dias.
model Product {
  id              String          @id @default(cuid())
  // Endereço da página de compra: /comprar/<slug>.
  slug            String          @unique
  title           String
  description     String          @default("")
  priceCents      Int             @map("price_cents")
  // Dias de acesso a partir do pagamento (ex.: 365). Vazio = sem data de fim.
  accessDays      Int?            @map("access_days")
  // Máximo de parcelas no cartão (1 = só à vista).
  maxInstallments Int             @default(1) @map("max_installments")
  // Só produtos ativos aparecem para os alunos.
  isActive        Boolean         @default(false) @map("is_active")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  courses         ProductCourse[]
  orders          Order[]
  // Fase 6: cupons restritos a este produto e páginas de edital que o oferecem.
  coupons         CouponProduct[]
  examNotices     ExamNotice[]

  @@map("products")
}

// Quais cursos um produto libera (um produto pode liberar vários; um curso pode estar em vários).
model ProductCourse {
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  courseId  String  @map("course_id")
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([productId, courseId])
  @@map("product_courses")
}

enum PlanCycle {
  MONTHLY
  YEARLY
}

// Plano de assinatura (ex.: mensal, anual). Libera todos os cursos com `includedInSubscription`.
model Plan {
  id            String         @id @default(cuid())
  // Endereço da página de assinatura: /assinar/<slug>.
  slug          String         @unique
  title         String
  description   String         @default("")
  priceCents    Int            @map("price_cents")
  cycle         PlanCycle
  isActive      Boolean        @default(false) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  subscriptions Subscription[]
  // Fase 6: cupons restritos a este plano e páginas de edital que o oferecem.
  coupons       CouponPlan[]
  examNotices   ExamNotice[]

  @@map("plans")
}

// Dados de cobrança do aluno (o Asaas exige CPF para gerar cobranças e notas fiscais).
// O CPF fica gravado depois da primeira compra (trocar = falar com o suporte).
model BillingProfile {
  userId             String               @id @map("user_id")
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Só os 11 dígitos, sem pontos e traço.
  cpf                String
  // Celular com DDD, só dígitos (opcional; o Asaas usa para avisos).
  phone              String?
  // Cliente correspondente no provedor (ex.: cus_000005219613) e qual provedor o criou.
  providerKind       PaymentProviderKind? @map("provider_kind")
  providerCustomerId String?              @map("provider_customer_id")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  @@map("billing_profiles")
}

// Situação de um pedido (compra avulsa). Calculada a partir das cobranças (ver `payments/rules.ts`).
enum OrderStatus {
  PENDING // aguardando pagamento
  OVERDUE // venceu sem pagamento (ainda pode ser pago, conforme o meio)
  PAID // pago: libera o acesso
  REFUND_REQUESTED // reembolso pedido (o acesso já foi retirado)
  REFUNDED // reembolsado
  CHARGEBACK // contestação no cartão (o acesso é retirado)
  CANCELED // cobrança cancelada/removida
}

// Uma compra avulsa. Guarda uma "foto" do que foi comprado (título, preço, dias e cursos):
// mudar o produto depois não altera compras já feitas.
model Order {
  id                     String              @id @default(cuid())
  userId                 String              @map("user_id")
  user                   User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  productId              String              @map("product_id")
  product                Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  productTitle           String              @map("product_title")
  priceCents             Int                 @map("price_cents")
  accessDays             Int?                @map("access_days")
  method                 PaymentMethod
  installments           Int                 @default(1)
  status                 OrderStatus         @default(PENDING)
  provider               PaymentProviderKind
  // Cobrança no provedor (numa compra parcelada: o "parcelamento" e a 1ª parcela).
  providerPaymentId      String?             @unique @map("provider_payment_id")
  providerInstallmentId  String?             @unique @map("provider_installment_id")
  // Quando o pagamento foi confirmado pela 1ª vez (início do acesso).
  paidAt                 DateTime?           @map("paid_at")
  // Quem pediu reembolso e quando (informativo). O acesso sai porque as cobranças passam a
  // REFUND_REQUESTED na hora do pedido; a situação do pedido vem sempre das cobranças.
  refundRequestedAt      DateTime?           @map("refund_requested_at")
  refundRequestedBy      String?             @map("refund_requested_by")
  // Mensagem do provedor quando a cobrança não pôde ser criada (para o suporte).
  failureReason          String?             @map("failure_reason")
  // Fase 6 ("foto" do momento da compra): desconto do cupom (preço de tabela = priceCents +
  // discountCents; `priceCents` é o valor COBRADO), o cupom, e o afiliado com a comissão combinada.
  discountCents          Int                 @default(0) @map("discount_cents")
  couponId               String?             @map("coupon_id")
  coupon                 Coupon?             @relation(fields: [couponId], references: [id], onDelete: Restrict)
  couponCode             String?             @map("coupon_code")
  affiliateId            String?             @map("affiliate_id")
  affiliate              Affiliate?          @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  affiliateCommissionBps Int?                @map("affiliate_commission_bps")
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")
  courses                OrderCourse[]
  payments               Payment[]

  @@index([userId, createdAt])
  @@index([couponId])
  @@index([affiliateId])
  @@map("orders")
}

// Cursos liberados por um pedido ("foto" do produto no momento da compra).
// `Restrict`: um curso com pedidos não pode ser apagado (histórico financeiro).
model OrderCourse {
  orderId  String @map("order_id")
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courseId String @map("course_id")
  course   Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@id([orderId, courseId])
  @@map("order_courses")
}

enum SubscriptionStatus {
  PENDING // criada, aguardando o 1º pagamento
  ACTIVE // renovando normalmente
  CANCELED // cancelada: não gera novas cobranças; o período já pago continua valendo
}

// Uma assinatura de um aluno. Cada ciclo pago (Payment) libera os cursos da assinatura até o
// fim daquele ciclo (+ alguns dias de tolerância para o pagamento seguinte ser confirmado).
model Subscription {
  id                     String              @id @default(cuid())
  userId                 String              @map("user_id")
  user                   User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  planId                 String              @map("plan_id")
  plan                   Plan                @relation(fields: [planId], references: [id], onDelete: Restrict)
  planTitle              String              @map("plan_title")
  priceCents             Int                 @map("price_cents")
  cycle                  PlanCycle
  method                 PaymentMethod
  status                 SubscriptionStatus  @default(PENDING)
  provider               PaymentProviderKind
  providerSubscriptionId String?             @unique @map("provider_subscription_id")
  canceledAt             DateTime?           @map("canceled_at")
  failureReason          String?             @map("failure_reason")
  // Fase 6: como no pedido — desconto do cupom (vale em todas as renovações: `priceCents` já é o
  // valor com desconto), o cupom e o afiliado com a comissão combinada (vale para cada ciclo pago).
  discountCents          Int                 @default(0) @map("discount_cents")
  couponId               String?             @map("coupon_id")
  coupon                 Coupon?             @relation(fields: [couponId], references: [id], onDelete: Restrict)
  couponCode             String?             @map("coupon_code")
  affiliateId            String?             @map("affiliate_id")
  affiliate              Affiliate?          @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  affiliateCommissionBps Int?                @map("affiliate_commission_bps")
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")
  payments               Payment[]

  @@index([userId, createdAt])
  @@index([couponId])
  @@index([affiliateId])
  @@map("subscriptions")
}

// Situação de uma cobrança (versão simplificada dos status do provedor — ver `asaas/status.ts`).
enum PaymentStatus {
  PENDING // aguardando pagamento
  OVERDUE // vencida
  CONFIRMED // paga (cartão aprovado; o dinheiro cai depois) — já libera o acesso
  RECEIVED // paga e recebida — libera o acesso
  REFUND_REQUESTED // estorno em andamento — acesso retirado
  REFUNDED // estornada — acesso retirado
  CHARGEBACK // contestação no cartão — acesso retirado
  CANCELED // removida/cancelada
}

// Uma cobrança no provedor: a de uma compra (ou uma parcela dela) ou um ciclo da assinatura.
model Payment {
  id                      String               @id @default(cuid())
  provider                PaymentProviderKind
  providerPaymentId       String               @unique @map("provider_payment_id")
  orderId                 String?              @map("order_id")
  order                   Order?               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  subscriptionId          String?              @map("subscription_id")
  subscription            Subscription?        @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  method                  PaymentMethod
  status                  PaymentStatus        @default(PENDING)
  // Status original do provedor (ex.: "RECEIVED_IN_CASH"), para conferência.
  providerStatus          String               @map("provider_status")
  valueCents              Int                  @map("value_cents")
  // Vencimento (dia). Na assinatura, é o início do ciclo que esta cobrança paga.
  dueDate                 DateTime             @map("due_date") @db.Date
  installmentNumber       Int?                 @map("installment_number")
  paidAt                  DateTime?            @map("paid_at")
  // Página de pagamento do provedor (cartão) e boleto em PDF.
  invoiceUrl              String?              @map("invoice_url")
  bankSlipUrl             String?              @map("bank_slip_url")
  // Pix "copia e cola" e a imagem do QR Code (PNG em base64), guardados na 1ª consulta.
  pixPayload              String?              @map("pix_payload")
  pixImage                String?              @map("pix_image")
  // Data do último aviso aplicado (texto do provedor, ex.: "2026-09-29 10:00:00"): um aviso mais
  // antigo que chegue atrasado não desfaz um mais novo.
  lastEventAt             String?              @map("last_event_at")
  // Estorno feito À MÃO no painel do provedor (boleto): o acesso já saiu aqui, mas o provedor ainda
  // mostra a cobrança como paga até alguém fazer o estorno lá. Enquanto isto estiver preenchido,
  // "paga" vinda do provedor NÃO devolve o acesso. Limpo quando o provedor mostra o estorno.
  manualRefundRequestedAt DateTime?            @map("manual_refund_requested_at")
  // Fase 7: última vez que a tarefa agendada conferiu esta cobrança direto no provedor (para
  // pegar um aviso/webhook perdido). A tarefa confere primeiro as que estão há mais tempo sem conferir.
  providerCheckedAt       DateTime?            @map("provider_checked_at")
  createdAt               DateTime             @default(now()) @map("created_at")
  updatedAt               DateTime             @updatedAt @map("updated_at")
  fiscalInvoice           FiscalInvoice?
  // Fase 6: em qual pagamento de comissão (ao afiliado) esta cobrança entrou, se entrou.
  affiliatePayoutItem     AffiliatePayoutItem?

  @@index([orderId])
  @@index([subscriptionId])
  @@index([status, providerCheckedAt])
  @@map("payments")
}

// Todo aviso (webhook) recebido do provedor, do jeito que chegou. Serve para:
//  - não processar o mesmo aviso duas vezes (`provider` + `eventId` únicos);
//  - investigar problemas e reprocessar um aviso que deu erro (painel → Vendas → Avisos).
model WebhookEvent {
  id          String              @id @default(cuid())
  provider    PaymentProviderKind
  eventId     String              @map("event_id")
  type        String
  payload     Json
  receivedAt  DateTime            @default(now()) @map("received_at")
  processedAt DateTime?           @map("processed_at")
  // Observação do processamento (ex.: "cobrança de fora do site: ignorada").
  note        String?
  // Erro do último processamento (vazio = deu certo).
  error       String?
  attempts    Int                 @default(0)

  @@unique([provider, eventId])
  @@index([receivedAt])
  @@map("webhook_events")
}

// Situação da nota fiscal de serviço (NFS-e) no provedor.
enum FiscalInvoiceStatus {
  PENDING // ainda não pedimos ao provedor (ou o pedido falhou — ver `error`)
  SCHEDULED // agendada no provedor
  AUTHORIZED // emitida pela prefeitura
  PROCESSING_CANCELLATION // cancelamento em andamento
  CANCELED // cancelada
  CANCELLATION_DENIED // a prefeitura recusou o cancelamento
  ERROR // a prefeitura recusou a emissão
}

// Nota fiscal de uma cobrança paga (Fase 4, opcional: liga com as variáveis NFSE_*).
model FiscalInvoice {
  id                String              @id @default(cuid())
  paymentId         String              @unique @map("payment_id")
  payment           Payment             @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  providerInvoiceId String?             @unique @map("provider_invoice_id")
  status            FiscalInvoiceStatus @default(PENDING)
  number            String?
  pdfUrl            String?             @map("pdf_url")
  xmlUrl            String?             @map("xml_url")
  error             String?
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@map("fiscal_invoices")
}

// -----------------------------------------------------------------------------
// Banco de questões (Fase 5): questões comentadas, simulados e o mapa "o que mais cai".
// -----------------------------------------------------------------------------

// Formato da questão.
enum QuestionType {
  // Múltipla escolha: alternativas A a E (algumas bancas usam só até D).
  MULTIPLE_CHOICE
  // Certo ou Errado (estilo Cebraspe): o aluno julga uma afirmação.
  TRUE_FALSE
}

// Onde o aluno respondeu (para as estatísticas).
enum AttemptSource {
  // "Resolver questões" (resposta e comentário na hora).
  PRACTICE
  // Simulado finalizado (o resultado só aparece no fim).
  MOCK_EXAM
}

// Banca organizadora de concursos (ex.: Cesgranrio, Cebraspe, FGV, FCC).
model Board {
  id        String       @id @default(cuid())
  // Identificador usado nos filtros da URL (?banca=cesgranrio).
  slug      String       @unique
  name      String       @unique
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  exams     Exam[]
  questions Question[]
  // Fase 6: páginas de edital desta banca.
  notices   ExamNotice[]

  @@map("boards")
}

// Assunto cobrado (ex.: "Segurança da Informação — malware"). É a base do mapa "o que mais cai"
// e do desempenho do aluno por assunto.
model Subject {
  id        String              @id @default(cuid())
  slug      String              @unique
  name      String              @unique
  // Ordem nas listas (menor primeiro; empate = ordem alfabética).
  position  Int                 @default(0)
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")
  questions Question[]
  // Fase 6: editais que cobram este assunto e posts do blog sobre ele.
  notices   ExamNoticeSubject[]
  blogPosts BlogPost[]

  @@map("subjects")
}

// Uma prova de concurso já aplicada (ex.: "Banco do Brasil — Escriturário", 2023, Cesgranrio).
// Questões ligadas a uma prova são as "de prova"; sem prova, são "inéditas" (autorais).
model Exam {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  year      Int
  boardId   String     @map("board_id")
  // Restrict: uma banca com provas cadastradas não pode ser apagada.
  board     Board      @relation(fields: [boardId], references: [id], onDelete: Restrict)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  questions Question[]

  @@index([boardId])
  @@map("exams")
}

// Uma questão comentada.
model Question {
  id            String             @id @default(cuid())
  // Código opcional e único (ex.: "BB2023-41"): evita importar a mesma questão duas vezes.
  code          String?            @unique
  type          QuestionType
  // Enunciado (texto puro; as quebras de linha são mantidas na tela).
  statement     String
  // Gabarito: "A" a "E" (múltipla escolha) ou "C"/"E" (Certo/Errado). NUNCA vai para a página
  // antes de o aluno responder.
  correctAnswer String             @map("correct_answer")
  // Comentário do professor: aparece depois da resposta (ou no fim do simulado).
  explanation   String
  subjectId     String             @map("subject_id")
  subject       Subject            @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  // Banca: preenchida sozinha a partir da prova; numa questão inédita, opcional ("no estilo de").
  boardId       String?            @map("board_id")
  board         Board?             @relation(fields: [boardId], references: [id], onDelete: Restrict)
  examId        String?            @map("exam_id")
  exam          Exam?              @relation(fields: [examId], references: [id], onDelete: Restrict)
  // Só questões publicadas aparecem para os alunos (e contam no mapa de incidência).
  isPublished   Boolean            @default(false) @map("is_published")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  options       QuestionOption[]
  attempts      QuestionAttempt[]
  mockExamItems MockExamQuestion[]

  @@index([subjectId])
  @@index([boardId])
  @@index([examId])
  @@index([isPublished, createdAt])
  @@map("questions")
}

// Uma alternativa de uma questão de múltipla escolha (Certo/Errado não tem alternativas).
model QuestionOption {
  id         String   @id @default(cuid())
  questionId String   @map("question_id")
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  // "A" a "E".
  label      String
  text       String

  @@unique([questionId, label])
  @@map("question_options")
}

// Uma resposta do aluno. Guardamos TODAS (não só a última): o desempenho conta cada tentativa.
model QuestionAttempt {
  id         String        @id @default(cuid())
  userId     String        @map("user_id")
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String        @map("question_id")
  // Restrict: questão respondida por alguém não se apaga (histórico do aluno) — despublicar.
  question   Question      @relation(fields: [questionId], references: [id], onDelete: Restrict)
  answer     String
  isCorrect  Boolean       @map("is_correct")
  source     AttemptSource
  mockExamId String?       @map("mock_exam_id")
  mockExam   MockExam?     @relation(fields: [mockExamId], references: [id], onDelete: Cascade)
  answeredAt DateTime      @default(now()) @map("answered_at")

  @@index([userId, answeredAt])
  @@index([questionId])
  @@index([mockExamId])
  @@map("question_attempts")
}

// Um simulado: questões sorteadas, respondidas sem ver o gabarito, com nota no fim.
model MockExam {
  id               String             @id @default(cuid())
  userId           String             @map("user_id")
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Descrição dos filtros usados no sorteio (ex.: "Cesgranrio · Segurança da Informação").
  title            String
  questionCount    Int                @map("question_count")
  // Tempo de prova em minutos (vazio = sem limite).
  timeLimitMinutes Int?               @map("time_limit_minutes")
  startedAt        DateTime           @default(now()) @map("started_at")
  // Preenchido ao finalizar (pelo aluno ou por tempo esgotado). Depois disso nada muda.
  finishedAt       DateTime?          @map("finished_at")
  correctCount     Int?               @map("correct_count")
  items            MockExamQuestion[]
  attempts         QuestionAttempt[]

  @@index([userId, startedAt])
  @@map("mock_exams")
}

// Uma questão dentro de um simulado, com a resposta marcada (ainda sem correção até o fim).
model MockExamQuestion {
  id         String    @id @default(cuid())
  mockExamId String    @map("mock_exam_id")
  mockExam   MockExam  @relation(fields: [mockExamId], references: [id], onDelete: Cascade)
  questionId String    @map("question_id")
  question   Question  @relation(fields: [questionId], references: [id], onDelete: Restrict)
  position   Int
  answer     String?
  answeredAt DateTime? @map("answered_at")
  // Preenchido ao finalizar o simulado.
  isCorrect  Boolean?  @map("is_correct")

  @@unique([mockExamId, questionId])
  @@unique([mockExamId, position])
  @@index([questionId])
  @@map("mock_exam_questions")
}

// -----------------------------------------------------------------------------
// Marketing (Fase 6): cupons de desconto, afiliados, blog, páginas de edital e endereços antigos.
// -----------------------------------------------------------------------------

// Tipo de desconto do cupom.
enum CouponDiscountType {
  PERCENT // porcentagem do preço (ex.: 10 = 10%)
  AMOUNT // valor fixo em centavos (ex.: 2000 = R$ 20,00)
}

// Cupom de desconto. O código fica em MAIÚSCULAS no banco (o aluno digita como quiser).
// Cupom usado em alguma venda não se apaga (desativar): o pedido guarda qual cupom foi usado.
model Coupon {
  id                String             @id @default(cuid())
  code              String             @unique
  // Anotação interna (ex.: "Campanha Black Friday"). Não aparece para o aluno.
  description       String             @default("")
  discountType      CouponDiscountType @map("discount_type")
  // PERCENT: de 1 a 100 (%). AMOUNT: centavos. O preço final nunca fica abaixo do mínimo de
  // cobrança (conferido no checkout).
  discountValue     Int                @map("discount_value")
  // Onde vale: compras avulsas, assinaturas ou as duas. A lista de produtos/planos restringe
  // ainda mais (vazia = todos daquele tipo). Na assinatura, o desconto vale em TODAS as renovações.
  appliesToProducts Boolean            @default(true) @map("applies_to_products")
  appliesToPlans    Boolean            @default(false) @map("applies_to_plans")
  // Período de validade (vazio = sem limite daquele lado).
  startsAt          DateTime?          @map("starts_at")
  endsAt            DateTime?          @map("ends_at")
  // Máximo de usos no total (vazio = sem limite) e por aluno.
  maxRedemptions    Int?               @map("max_redemptions")
  maxPerUser        Int                @default(1) @map("max_per_user")
  isActive          Boolean            @default(true) @map("is_active")
  // Cupom de um afiliado: a venda com este cupom conta para ele (mesmo sem o link).
  affiliateId       String?            @map("affiliate_id")
  affiliate         Affiliate?         @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  products          CouponProduct[]
  plans             CouponPlan[]
  orders            Order[]
  subscriptions     Subscription[]

  @@map("coupons")
}

// Produtos em que o cupom vale (vazio = todos, se `appliesToProducts`).
model CouponProduct {
  couponId  String  @map("coupon_id")
  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
  @@map("coupon_products")
}

// Planos em que o cupom vale (vazio = todos, se `appliesToPlans`).
model CouponPlan {
  couponId String @map("coupon_id")
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  planId   String @map("plan_id")
  plan     Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([couponId, planId])
  @@map("coupon_plans")
}

// Afiliado: alguém (com conta no site) que divulga os cursos e ganha comissão pelas vendas.
// Não se apaga (as vendas guardam o afiliado): desativar para de atribuir vendas novas.
model Affiliate {
  id            String              @id @default(cuid())
  userId        String              @unique @map("user_id")
  user          User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  // Código do link de divulgação (/r/<codigo>): letras minúsculas, números e hífen.
  code          String              @unique
  // Comissão em "pontos-base" (100 = 1%): 2000 = 20%. Guardada no pedido no momento da venda.
  commissionBps Int                 @map("commission_bps")
  // Como pagar a comissão (ex.: "Pix: chave@email.com"). Só o admin e o próprio afiliado veem.
  payoutInfo    String              @default("") @map("payout_info")
  isActive      Boolean             @default(true) @map("is_active")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  clickDays     AffiliateClickDay[]
  coupons       Coupon[]
  orders        Order[]
  subscriptions Subscription[]
  payouts       AffiliatePayout[]

  @@map("affiliates")
}

// Cliques no link do afiliado, somados por dia (um contador por dia, não uma linha por clique).
model AffiliateClickDay {
  affiliateId String    @map("affiliate_id")
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  day         DateTime  @db.Date
  clicks      Int       @default(0)

  @@id([affiliateId, day])
  @@map("affiliate_click_days")
}

// Pagamento de comissões a um afiliado, feito FORA do site (ex.: Pix) e registrado pelo admin.
// Registro financeiro: nunca é apagado.
model AffiliatePayout {
  id          String                @id @default(cuid())
  affiliateId String                @map("affiliate_id")
  affiliate   Affiliate             @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  amountCents Int                   @map("amount_cents")
  note        String                @default("")
  // Quem registrou (admin).
  createdById String                @map("created_by_id")
  createdBy   User                  @relation("AffiliatePayoutCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime              @default(now()) @map("created_at")
  items       AffiliatePayoutItem[]

  @@index([affiliateId, createdAt])
  @@map("affiliate_payouts")
}

// Cada cobrança paga que entrou num pagamento de comissão — no máximo UMA vez (chave única).
model AffiliatePayoutItem {
  payoutId    String          @map("payout_id")
  payout      AffiliatePayout @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  paymentId   String          @unique @map("payment_id")
  payment     Payment         @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  amountCents Int             @map("amount_cents")

  @@id([payoutId, paymentId])
  @@map("affiliate_payout_items")
}

// Situação de um concurso (página de edital).
enum ExamNoticeStatus {
  EXPECTED // previsto (edital ainda não saiu)
  OPEN // inscrições abertas
  CLOSED // inscrições encerradas, prova por vir
  DONE // prova já aplicada
}

// Página de um concurso/edital (landing page): /concursos/<slug>.
model ExamNotice {
  id                 String              @id @default(cuid())
  slug               String              @unique
  // Ex.: "Banco do Brasil 2026 — Escriturário".
  title              String
  // Órgão (ex.: "Banco do Brasil") e cargo (ex.: "Escriturário — Agente Comercial").
  organization       String
  role               String              @default("")
  // Banca (Fase 5): liga ao mapa "o que mais cai" e às questões dela.
  boardId            String?             @map("board_id")
  board              Board?              @relation(fields: [boardId], references: [id], onDelete: SetNull)
  status             ExamNoticeStatus    @default(EXPECTED)
  registrationEndsOn DateTime?           @map("registration_ends_on") @db.Date
  examDate           DateTime?           @map("exam_date") @db.Date
  // Textos livres (ex.: "6.000 + cadastro reserva", "R$ 3.622,23").
  vacancies          String              @default("")
  salary             String              @default("")
  // Resumo (lista de concursos e descrição para o Google) e texto da página (Markdown simples).
  summary            String              @default("")
  body               String              @default("")
  // Link do edital oficial (só https).
  officialUrl        String?             @map("official_url")
  // O que oferecer na página: um produto e/ou um plano, com um cupom opcional já aplicado.
  productId          String?             @map("product_id")
  product            Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  planId             String?             @map("plan_id")
  plan               Plan?               @relation(fields: [planId], references: [id], onDelete: SetNull)
  couponCode         String?             @map("coupon_code")
  isPublished        Boolean             @default(false) @map("is_published")
  publishedAt        DateTime?           @map("published_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  // Assuntos de TI cobrados neste edital ("o que estudar" + atalho para as questões).
  subjects           ExamNoticeSubject[]

  @@index([isPublished, examDate])
  @@map("exam_notices")
}

model ExamNoticeSubject {
  noticeId  String     @map("notice_id")
  notice    ExamNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  subjectId String     @map("subject_id")
  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([noticeId, subjectId])
  @@map("exam_notice_subjects")
}

// Post do blog: /blog/<slug>. Texto em Markdown simples (sem HTML).
model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  // Resumo (lista do blog e descrição para o Google).
  excerpt     String    @default("")
  body        String
  // Autor (professor/admin). Se a conta for apagada, o post fica sem autor.
  authorId    String?   @map("author_id")
  author      User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  // Assunto (Fase 5) do post: atalho "treine questões deste assunto" no fim do texto.
  subjectId   String?   @map("subject_id")
  subject     Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  isPublished Boolean   @default(false) @map("is_published")
  // Data de publicação (a primeira vez que foi publicado; aparece no post e ordena a lista).
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([isPublished, publishedAt])
  @@map("blog_posts")
}

// O que tem endereço público que pode mudar (e o endereço antigo precisa redirecionar).
enum SlugRedirectKind {
  COURSE
  LESSON
  BLOG_POST
  EXAM_NOTICE
}

// Endereço antigo → item atual. Quando o slug de um curso/aula/post/edital muda, o endereço antigo
// continua funcionando (redireciona para o novo) — links compartilhados e o Google não quebram.
model SlugRedirect {
  id        String           @id @default(cuid())
  kind      SlugRedirectKind
  // Onde o slug é único: aula = ID do curso; os demais = "" (únicos no site todo).
  scope     String           @default("")
  oldSlug   String           @map("old_slug")
  // ID do curso/aula/post/edital (sem chave estrangeira: aponta para tabelas diferentes).
  targetId  String           @map("target_id")
  createdAt DateTime         @default(now()) @map("created_at")

  @@unique([kind, scope, oldSlug])
  @@map("slug_redirects")
}
